# ==============================================================================
# SentinelIQ — Environment Configuration Template
# Intelligent Transaction Risk & Investigation Platform
# Tagline: Explainable Risk. Traceable Decisions.
# ==============================================================================

# Application Environment: 'development', 'staging', 'production', 'test'
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security & Authentication
# Generate a secure 256-bit random string for production (e.g., via `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo User Provisioning (Development / Review only; set to false in production)
ENABLE_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=SentinelIQ@Admin2026!
DEMO_ANALYST_PASSWORD=SentinelIQ@Analyst2026!
DEMO_COMPLIANCE_PASSWORD=SentinelIQ@Compliance2026!
DEMO_READONLY_PASSWORD=SentinelIQ@ReadOnly2026!

# Database Persistence (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentineliq_risk_intelligence

# Storage Mode: 'mongodb' (standard production) or 'memory' (in-memory mock for sandbox/tests)
APP_STORAGE=mongodb

# Service URLs & CORS
FRONTEND_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","https://sentineliq.vercel.app"]

# Generator & Risk Engine Defaults
DEFAULT_SEED=20261022
DEFAULT_PROFILE=demo
DATASET_EXPORT_DIR=./exports
GROUND_TRUTH_DIR=./ground_truth
REPORTS_DIR=./reports

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
