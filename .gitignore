# Large generated exports (preserve folder structure with .gitkeep)
exports/*.csv
exports/*.json
exports/*.sql
!exports/manifest.json
!exports/.gitkeep
reports/*.json
!reports/evaluation_summary.json
!reports/validation_summary.json
!reports/checksums.json
!reports/.gitkeep
ground_truth/*.csv
ground_truth/*.json
!ground_truth/.gitkeep
